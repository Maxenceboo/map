<?xml version="1.0" encoding="utf-8"?>
<!--
  Logo : la flèche jaune du joueur, en relief, au bout de son itinéraire violet.
  Tout tient dans la zone sûre de l'icône adaptative (le carré central de 66 sur 108).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Itinéraire : liseré sombre, puis ligne violette. -->
    <path
        android:strokeColor="#3B0764"
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:pathData="M32,112 C32,88 54,88 54,64" />
    <path
        android:strokeColor="#C084FC"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M32,112 C32,88 54,88 54,64" />
    <!-- Socle sombre : donne l'épaisseur de la flèche. -->
    <path android:fillColor="#0B0D12" android:pathData="M54,30 L77,76 L54,65 L31,76 Z" />
    <!-- Flèche : moitié gauche éclairée, moitié droite dans l'ombre. -->
    <path android:fillColor="#FFC533" android:pathData="M54,25 L33,70 L54,60 Z" />
    <path android:fillColor="#DB9E14" android:pathData="M54,25 L75,70 L54,60 Z" />
</vector>
